# ============================================================
# PRI SuperApp — contoh pengaturan lingkungan
#
# CARA PAKAI: salin file ini menjadi ".env.local", lalu isi
# nilainya. File .env.local TIDAK ikut ter-upload ke Git.
#
# PENTING: jangan pernah menambahkan awalan NEXT_PUBLIC_ pada
# kunci-kunci di bawah. Awalan itu membuat nilainya ikut terkirim
# ke browser pengguna — kunci rahasia Anda akan bocor.
# ============================================================

# --- Supabase (wajib) ---------------------------------------
# Ambil di: Supabase → Settings → API
# URL project, bentuknya https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Secret key (sb_secret_... atau service_role). HANYA dipakai di
# server. Kunci ini melewati RLS, jadi jangan dibagikan.
SUPABASE_SECRET_KEY=


# --- n8n (opsional, untuk fitur otomatisasi) -----------------
# URL webhook workflow "TV Rakyat - Cek Berita Terbaru".
# Dipakai tombol "Cek Berita Terbaru dari Nusantara TV".
# Contoh: https://xxxxx.app.n8n.cloud/webhook/tv-scrape
N8N_WEBHOOK_SCRAPE_BERITA=

# URL webhook workflow "TV Rakyat - Proses Video".
# Dipakai tombol "Proses Video".
# Kosongkan bila belum dibuat — aplikasi tetap jalan, hanya
# memakai teks template untuk judul/caption.
N8N_WEBHOOK_PROSES_VIDEO=

# URL webhook n8n untuk mengirim pengingat WhatsApp (via Fonnte).
# Kosongkan bila belum dibuat — tombol "Ingatkan Semua" akan
# memberi tahu bahwa otomatisasi belum tersambung.
N8N_WEBHOOK_INGATKAN=

# Webhook workflow "QC Konten v5 (TikHub)" — dipicu tombol "Mulai Analisis"
# di layar QC. Workflow membalas segera lalu bekerja di latar belakang.
N8N_WEBHOOK_QC_MULAI=

# Kata sandi bersama antara aplikasi dan n8n. Bila diisi, aplikasi
# mengirimkannya sebagai header X-PRI-Secret di setiap panggilan,
# dan n8n bisa menolak permintaan yang tidak menyertakannya.
N8N_WEBHOOK_SECRET=


# --- Prisma (sisa template, tidak dipakai) -------------------
# Aplikasi ini memakai Supabase, bukan SQLite. Baris ini hanya
# supaya perintah prisma bawaan tidak error bila dijalankan.
DATABASE_URL=file:./db/custom.db
N8N_WEBHOOK_QC_LANJUT=

AYRSHARE_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AYRSHARE_PROFILE_KEY=

# --- Upstash Redis (OPSIONAL) --------------------------------
# Dipakai dua hal: pembatas laju percobaan login/OTP dan cache
# sesi 60 detik. KEDUANYA TETAP JALAN tanpa ini — aplikasi
# otomatis memakai memori proses sebagai gantinya.
#
# KAPAN INI PENTING: begitu aplikasi berjalan di lebih dari satu
# instance (Vercel serverless, atau beberapa server sekaligus),
# hitungan di memori jadi terpisah-pisah per instance sehingga
# batas percobaan login praktis tidak berlaku. Redis membuat
# hitungannya terpusat.
#
# Ambil di: Upstash → Redis → Details → REST API. Pilih region
# yang sama dengan database (Singapura), jangan Amerika.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bila Redis dipasang lewat integrasi Vercel Marketplace, Vercel
# menyuntikkan nama KV_REST_API_URL / KV_REST_API_TOKEN. Aplikasi
# menerima kedua penamaan, jadi tidak perlu diubah apa pun.

# --- Studio PALUGODAM (3 Sep 2026) ---
# DeepSeek: pembangkit judul/highlight/caption per profil (https://platform.deepseek.com → API keys)
DEEPSEEK_API_KEY=
# Creatomate: render video per template profil (https://creatomate.com → Project → API Keys)
CREATOMATE_API_KEY=
