{
 "nama": "bawaan_kanvas",
 "args": [
  "ffmpeg",
  "-hide_banner",
  "-loglevel",
  "error",
  "-nostdin",
  "-y",
  "-threads",
  "2",
  "-filter_complex_threads",
  "1",
  "-t",
  "8.000",
  "-i",
  "{MEDIA}/sumber/sumber_panjang.mp4",
  "-i",
  "{MEDIA}/templates/bawaan_kanvas/assets/logo.png",
