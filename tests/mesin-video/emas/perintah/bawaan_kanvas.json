  "-map",
  "[b1]",
  "-map",
  "[ba]",
  "-c:v",
  "libx264",
  "-preset",
  "veryfast",
  "-crf",
  "23",
  "-pix_fmt",
  "yuv420p",
  "-profile:v",
  "high",
  "-r",
  "30",
  "-c:a",
  "aac",
  "-b:a",
  "128k",
  "-ar",
  "44100",
