# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# KECUALI contoh tanpa isi rahasia — ini justru harus ikut tersimpan
# supaya orang lain tahu variabel apa saja yang perlu diisi.
!.env.example

# CATATAN PENTING: taruh kunci rahasia HANYA di .env.local.
# Jangan di .env — file itu sudah terlanjur terlacak Git sejak awal,
# jadi isinya akan ikut ter-commit dan bisa terbaca orang lain.

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
.vercel

# Kunci penanda tangan APK — RAHASIA, jangan pernah di-commit
apk/*.keystore
apk/KUNCI-PENTING.txt
apk/build/
# Artefak hasil build Gradle. Tanpa tiga baris di bawah, sekali `node
# scripts/bangun-apk.mjs` dijalankan ada ~514 berkas (33 MB) yang ikut masuk
# ke git dan mengotori tiap diff. Berkasnya bisa dibuat ulang kapan saja.
apk/.gradle/
apk/app/build/
apk/*.apk
apk/*.idsig

# Kredensial Cloudflare (jangan pernah di-commit)
.env.cloudflare
