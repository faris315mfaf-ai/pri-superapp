# =====================================================================
# RUMAH BOT (runner Bot Redaksi) — contoh berkas env, 13 Okt 2026.
#
# Salin ke /opt/pri-mesin/bot.env DI VPS MESIN, isi di sana, izin 0600:
#   install -m 0600 /dev/null /opt/pri-mesin/bot.env
# JANGAN pernah memasukkan nilai asli ke repo. Berkas ini hanya daftar nama.
# Langkah lengkap: docs/BOT-REDAKSI-RUNNER.md
# =====================================================================

# Alamat dasar aplikasi lewat internet publik (HTTPS, tanpa garis miring
# akhir). Firewall keluar kontainer menolak alamat privat, jadi jalur
# WireGuard (10.77.0.x) TIDAK bisa dipakai.
APP_URL=

# Rahasia tanda tangan HMAC runner (minimal 16 karakter, sebaiknya 48+ acak).
# HARUS sama persis dengan BOT_RUNNER_SECRET di env aplikasi. Hasilkan mis.:
#   openssl rand -hex 32
BOT_RUNNER_SECRET=

# (Opsional) berkas cookies Netscape untuk yt-dlp dari AKUN TUMBAL (bukan akun
# utama). Wajib bila Instagram/TikTok menuntut login. Contoh jalur di dalam
# kontainer (lihat volume yang dikomentari di docker-compose.yml):
# BOT_COOKIES_FILE=/run/bot-cookies/cookies.txt

# (Opsional) soket API mesin di dalam kontainer; bawaannya sudah benar.
# AUTOEDIT_SOCKET=/run/autoedit/api.sock

# (Opsional) selang denyut ke aplikasi dalam milidetik (5000..60000, bawaan 15000)
# dan jeda bot saat tidak ada tugas (3000..120000, bawaan 15000).
# BOT_DENYUT_MS=15000
# BOT_JEDA_DIAM_MS=15000
