# Normalisasi akhir baris lintas-OS (Windows <-> macOS <-> Linux).
# Repo SELALU menyimpan LF; checkout juga LF di semua OS supaya tidak ada
# berkas yang "berubah" hanya karena pindah laptop.
* text=auto eol=lf

# Skrip & berkas yang DIJALANKAN di Linux/VPS wajib LF (CRLF membuatnya gagal).
*.sh text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Berkas biner: jangan disentuh git (jangan dinormalisasi / di-diff).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg -text
*.mp4 binary
*.mov binary
*.webm binary
*.m4v binary
*.mp3 binary
*.wav binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.jar binary
*.apk binary
*.keystore binary
*.jks binary
